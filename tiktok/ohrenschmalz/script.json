  "lines": [
    {
      "id": "s1",
      "speaker": "tr",
      "start": 0.1,
      "end": 1.1,
      "text": "Hallo?! Ich hör gar nichts mehr!",
      "emph": ["nichts"]
    },
    {
      "id": "s2",
      "speaker": "pf",
      "start": 1.4,
      "end": 2.4,
      "text": "Psst. Ich mach's mir hier gemütlich.",
      "emph": ["gemütlich"]
    },
    {
      "id": "s3",
      "speaker": "tr",
      "start": 2.6,
      "end": 3.6,
      "text": "Was?!"
    },
    {
      "id": "s4",
      "speaker": "tr",
      "start": 3.2,
      "end": 4.2,
      "text": "Du verstopfst das ganze Ohr!",
      "emph": ["verstopfst"]
    },
    {
      "id": "w1",
      "speaker": "watt",
      "start": 4.4,
      "end": 5.4,
      "text": "Keine Sorge! Ich mach das sauber!",
      "emph": ["sauber"]
    },
    {
      "id": "s5",
      "speaker": "tr",
      "start": 6.0,
      "end": 7.0,
      "text": "Aua! Du schiebst ihn ja rein!",
      "emph": ["rein"]
    },
    {
      "id": "s6",
      "speaker": "pf",
      "start": 7.2,
      "end": 8.2,
      "text": "Danke, Kumpel. Jetzt lieg ich noch bequemer.",
      "emph": ["bequemer"]
    },
    {
      "id": "w2",
      "speaker": "watt",
      "start": 8.8,
      "end": 9.8,
      "text": "Upps."
    },
    {
      "id": "o1",
      "speaker": "pf",
      "start": 20.6,
      "end": 21.6,
      "text": "Hey! Wer kippt hier Öl auf mich?",
      "emph": ["Öl"]
    },
    {
      "id": "o2",
      "speaker": "pf",
      "start": 23.0,
      "end": 24.0,
      "text": "Nein! Ich hab hier einen Mietvertrag!",
      "emph": ["Mietvertrag"]
    },
    {
      "id": "o3",
      "speaker": "tr",
      "start": 27.2,
      "end": 28.2,
      "text": "Ich hör alles! Sogar das Gras wachsen!",
      "emph": ["alles"]
    },
    {
      "id": "d1",
      "speaker": "arzt",
      "start": 35.3,
      "end": 36.3,
      "text": "Das Ohr reinigt sich selbst. Wattestäbchen schieben das Schmalz nur tiefer."
    },
    {
      "id": "e1",
      "speaker": "pat",
      "start": 40.3,
      "end": 41.3,
      "text": "Nur ganz kurz…"
    },
    {
      "id": "e2",
      "speaker": "watt",
      "start": 41.2,
      "end": 42.2,
      "text": "Nicht ich! Ich geh in Rente!",
      "emph": ["Rente"]
    }
  ],
