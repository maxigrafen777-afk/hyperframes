{
  "title": "Eingewachsener Zehennagel wird entfernt",
  "handle": "Dr. Arzterklärt",
  "duration": 0,
  "voiceModel": "eleven_v3",
  "hook": [
    ["EINGEWACHSENER", 84, "#fff"],
    ["ZEHNAGEL?", 124, "#FFE14D"],
    ["SO WIRD ER ENTFERNT", 62, "#fff"]
  ],
  "scenes": {
    "streit": [0, 9.0],
    "spaeter": [10, 11.4],
    "nachher": [20, 25.5],
    "op": [30, 48],
    "frage": [50, 52],
    "praxis": [55, 60],
    "patient": [65, 68.5]
  },
  "order": ["streit", "spaeter", "nachher", "op", "frage", "praxis", "patient"],
  "lines": [
    {
      "id": "s1",
      "speaker": "zeh",
      "start": 0.35,
      "end": 1.6,
      "text": "[shouting] Aua! Hör auf, dich in mich reinzubohren!"
    },
    {
      "id": "s2",
      "speaker": "nagel",
      "start": 1.8,
      "end": 2.8,
      "text": "Ich bohr nicht. Ich wachs nur zur Seite!"
    },
    {
      "id": "s3",
      "speaker": "zeh",
      "start": 3.2,
      "end": 4.2,
      "text": "[angry] Zur Seite?! Da bin ICH!"
    },
    {
      "id": "s4",
      "speaker": "nagel",
      "start": 4.4,
      "end": 5.4,
      "text": "[mischievously] Tja. Hättest halt mehr Platz machen sollen."
    },
    {
      "id": "s5",
      "speaker": "zeh",
      "start": 5.8,
      "end": 6.8,
      "text": "[whining] Die SCHUHE sind zu eng!"
    },
    {
      "id": "s6",
      "speaker": "nagel",
      "start": 7.2,
      "end": 8.2,
      "text": "[laughs] Und wer schneidet mich so rund?"
    },
    {
      "id": "l6",
      "speaker": "card",
      "start": 10.1,
      "end": 11.1,
      "text": "Später"
    },
    {
      "id": "n1",
      "speaker": "zeh",
      "start": 20.3,
      "end": 21.3,
      "text": "[whining] Jetzt pocht's auch noch!"
    },
    {
      "id": "n2",
      "speaker": "zeh",
      "start": 21.4,
      "end": 22.4,
      "text": "Guck mal, wie ROT ich bin!"
    },
    {
      "id": "n3",
      "speaker": "nagel",
      "start": 22.6,
      "end": 23.6,
      "text": "[mischievously] Steht dir."
    },
    {
      "id": "n4",
      "speaker": "zeh",
      "start": 23.4,
      "end": 24.4,
      "text": "[shouting] DOC! Hol ihn da raus!"
    },
    {
      "id": "n5",
      "speaker": "nagel",
      "start": 24.6,
      "end": 25.6,
      "text": "[nervous] Moment… ganz raus?!"
    },
    {
      "id": "o1",
      "speaker": "zeh",
      "start": 30.8,
      "end": 31.8,
      "text": "[shouting] AUA! Die SPRITZE!"
    },
    {
      "id": "o2",
      "speaker": "zeh",
      "start": 33.0,
      "end": 34.0,
      "text": "[slurring] Ich spür… meinen Zeh nicht mehr…"
    },
    {
      "id": "o3",
      "speaker": "nagel",
      "start": 35.4,
      "end": 36.4,
      "text": "[panicked] Hey! Warum hebt ihr mich hoch?!"
    },
    {
      "id": "o4",
      "speaker": "nagel",
      "start": 37.6,
      "end": 38.6,
      "text": "[screaming] NICHT SCHNEIDEN!"
    },
    {
      "id": "o5",
      "speaker": "nagel",
      "start": 40.6,
      "end": 41.6,
      "text": "[sighs] Puh… nur der Rand."
    },
    {
      "id": "o6",
      "speaker": "nagel",
      "start": 42.6,
      "end": 43.6,
      "text": "[panicked] Was macht ihr an meiner WURZEL?!"
    },
    {
      "id": "o7",
      "speaker": "zeh",
      "start": 45.8,
      "end": 46.8,
      "text": "[sighs] Endlich… Platz."
    },
    {
      "id": "q1",
      "speaker": "pat",
      "start": 50.3,
      "end": 51.3,
      "text": "[nervous] Doc, war das jetzt der ganze Nagel?"
    },
    {
      "id": "d1",
      "speaker": "arzt",
      "start": 55.4,
      "end": 56.4,
      "text": "Nein. Ihr Nagel war seitlich eingewachsen und hat sich entzündet."
    },
    {
      "id": "d2",
      "speaker": "arzt",
      "start": 57.0,
      "end": 58.0,
      "text": "Wir haben betäubt und nur den eingewachsenen Rand schmal entfernt."
    },
    {
      "id": "d3",
      "speaker": "arzt",
      "start": 58.5,
      "end": 59.5,
      "text": "An der Stelle haben wir die Wurzel verödet. Dort wächst er normalerweise nicht mehr nach."
    },
    {
      "id": "e1",
      "speaker": "pat",
      "start": 65.3,
      "end": 66.3,
      "text": "Und wann passen meine Lieblingsschuhe wieder?"
    },
    {
      "id": "e2",
      "speaker": "arzt",
      "start": 66.8,
      "end": 67.8,
      "text": "[warmly] Erst mal nur offene Schuhe. Und Nägel immer GERADE schneiden."
    }
  ],
