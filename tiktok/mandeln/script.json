{
  "title": "Mandeln werden entfernt",
  "handle": "Dr. Arzterklärt",
  "duration": 0,
  "voiceModel": "eleven_multilingual_v2",
  "hook": [
    ["WARUM HILFT", 80, "#fff"],
    ["EIS", 150, "#7FE3FF"],
    ["NICHT MEHR?", 86, "#fff"]
  ],
  "scenes": {
    "teaser": [90, 92.8],
    "streit": [0, 14.0],
    "spaeter": [15, 16.4],
    "nachher": [20, 24.0],
    "op": [30, 48],
    "praxis": [55, 57],
    "patient": [60, 64]
  },
  "order": ["teaser", "streit", "spaeter", "nachher", "op", "praxis", "patient"],
  "qa": {
    "maxTakes": 3,
    "maxWer": 0.1
  },
  "lines": [
    {
      "id": "t1",
      "speaker": "ml",
      "start": 90.3,
      "end": 91.3,
      "text": "Nicht ohne meinen Bruder!",
      "emph": ["Bruder"],
      "reuse": "o3"
    },
    {
      "id": "s1",
      "speaker": "zp",
      "start": 0.35,
      "end": 1.35,
      "text": "Hey! Ihr zwei! Ich krieg keine Luft!",
      "emph": ["Luft"]
    },
    {
      "id": "s2",
      "speaker": "ml",
      "start": 1.6,
      "end": 2.6,
      "text": "Wir sind die Türsteher!",
      "emph": ["Türsteher"]
    },
    {
      "id": "s3",
      "speaker": "mr",
      "start": 2.6,
      "end": 3.6,
      "text": "Genau!"
    },
    {
      "id": "s4",
      "speaker": "zp",
      "start": 3.6,
      "end": 4.6,
      "text": "Türsteher? Ihr seid voller Bakterien!",
      "emph": ["Bakterien"]
    },
    {
      "id": "i1",
      "speaker": "zp",
      "start": 7.0,
      "end": 8.0,
      "text": "Oh! Ein Eis! Das kühlt so schön!",
      "emph": ["Eis"]
    },
    {
      "id": "i2",
      "speaker": "ml",
      "start": 9.0,
      "end": 10.0,
      "text": "Brrr… ist das kalt!",
      "emph": ["kalt"]
    },
    {
      "id": "i3",
      "speaker": "mr",
      "start": 11.0,
      "end": 12.0,
      "text": "Netter Versuch.",
      "emph": ["Versuch"]
    },
    {
      "id": "l6",
      "speaker": "card",
      "start": 15.1,
      "end": 16.1,
      "text": "Später"
    },
    {
      "id": "n1",
      "speaker": "zp",
      "start": 20.3,
      "end": 21.3,
      "text": "Schon wieder entzündet! Das fünfte Mal dieses Jahr!",
      "emph": ["fünfte"]
    },
    {
      "id": "n2",
      "speaker": "ml",
      "start": 21.6,
      "end": 22.6,
      "text": "Wir ziehen hier nicht aus."
    },
    {
      "id": "n3",
      "speaker": "zp",
      "start": 22.8,
      "end": 23.8,
      "text": "Herr Doktor! Holen Sie die raus!",
      "emph": ["Doktor"]
    },
    {
      "id": "a1",
      "speaker": "arzt",
      "start": 30.2,
      "end": 31.2,
      "text": "Der Patient schläft. Ein Sperrer hält den Mund weit offen.",
      "emph": ["Sperrer"]
    },
    {
      "id": "a2",
      "speaker": "arzt",
      "start": 32.0,
      "end": 33.0,
      "text": "Wir fassen die Mandel und lösen sie vorsichtig aus ihrem Bett.",
      "emph": ["Mandel"]
    },
    {
      "id": "o2",
      "speaker": "mr",
      "start": 33.0,
      "end": 34.0,
      "text": "Hey! Das ist meine Wohnung!",
      "emph": ["Wohnung"]
    },
    {
      "id": "a3",
      "speaker": "arzt",
      "start": 34.0,
      "end": 35.0,
      "text": "Dann kommt sie heraus. Danach die zweite.",
      "emph": ["zweite"]
    },
    {
      "id": "o3",
      "speaker": "ml",
      "start": 35.0,
      "end": 36.0,
      "text": "Nicht ohne meinen Bruder!",
      "emph": ["Bruder"]
    },
    {
      "id": "a4",
      "speaker": "arzt",
      "start": 36.0,
      "end": 37.0,
      "text": "Zum Schluss stillen wir die Blutung.",
      "emph": ["Blutung"]
    },
    {
      "id": "o4",
      "speaker": "zp",
      "start": 37.0,
      "end": 38.0,
      "text": "Endlich… Luft!",
      "emph": ["Luft"]
    },
    {
      "id": "d1",
      "speaker": "arzt",
      "start": 55.3,
      "end": 56.3,
      "text": "Bei ständigen Entzündungen hilft Kühlen nur kurz. Dann ist die OP oft die beste Lösung."
    },
    {
      "id": "e1",
      "speaker": "pat",
      "start": 60.3,
      "end": 61.3,
      "text": "Darf ich jetzt endlich Eis essen?"
    },
    {
      "id": "e2",
      "speaker": "arzt",
      "start": 61.5,
      "end": 62.5,
      "text": "Kaltes ja. Aber nichts Hartes oder Scharfes."
    },
    {
      "id": "e3",
      "speaker": "pat",
      "start": 63.0,
      "end": 64.0,
      "text": "Juhu! … Au!",
      "maxPause": 0.7
    }
  ],
