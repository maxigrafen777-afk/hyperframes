  },
  "order": ["teaser", "streit", "nachher", "op", "praxis", "patient"],
  "qa": {
    "maxTakes": 3,
    "maxWer": 0.1
  },
  "lines": [
    {
      "id": "t1",
      "speaker": "ml",
      "start": 90.3,
      "end": 91.3,
      "text": "Nicht ohne meinen Bruder!",
      "emph": ["Bruder"],
      "reuse": "o4"
    },
    {
      "id": "s1",
      "speaker": "zp",
      "start": 0.35,
      "end": 1.35,
      "text": "Hey, ihr zwei Fettklöße! Ich krieg keine Luft!",
      "emph": ["Fettklöße"]
    },
    {
      "id": "s2",
      "speaker": "ml",
      "start": 1.6,
      "end": 2.6,
      "text": "Fettklöße? Das sind Muskeln, Kleiner.",
      "emph": ["Muskeln"]
    },
    {
      "id": "s3",
      "speaker": "mr",
      "start": 2.6,
      "end": 3.6,
      "text": "Und du bist nur ein Wackelpudding mit Gesicht.",
      "emph": ["Wackelpudding"]
    },
    {
      "id": "s4",
      "speaker": "zp",
      "start": 3.6,
      "end": 4.6,
      "text": "Ihr seid voller Bakterien!",
      "emph": ["Bakterien"]
    },
    {
      "id": "s5",
      "speaker": "mr",
      "start": 4.8,
      "end": 5.8,
      "text": "Das sind keine Bakterien. Das sind unsere Gäste.",
      "emph": ["Gäste"]
    },
    {
      "id": "i0",
      "speaker": "eis",
      "start": 7.0,
      "end": 8.0,
      "text": "Keine Panik! Hier kommt die Kälte!",
      "emph": ["Kälte"]
    },
    {
      "id": "i2",
      "speaker": "ml",
      "start": 9.0,
      "end": 10.0,
      "text": "Brrr… okay, das ist frisch.",
      "emph": ["frisch"]
    },
    {
      "id": "i3",
      "speaker": "eis",
      "start": 10.0,
      "end": 11.0,
      "text": "Ich… schmelze! Das ist ja wie in der Sauna hier!",
      "emph": ["Sauna"],
      "maxPause": 0.5
    },
    {
      "id": "i4",
      "speaker": "mr",
      "start": 11.0,
      "end": 12.0,
      "text": "Tschüss, Eis. Netter Versuch.",
      "emph": ["Tschüss"]
    },
    {
      "id": "n2",
      "speaker": "ml",
      "start": 21.3,
      "end": 22.3,
      "text": "Wir ziehen hier nicht aus."
    },
    {
      "id": "n3",
      "speaker": "zp",
      "start": 22.3,
      "end": 23.3,
      "text": "Herr Doktor! Holen Sie die raus!",
      "emph": ["Doktor"]
    },
    {
      "id": "o1",
      "speaker": "mr",
      "start": 30.9,
      "end": 31.9,
      "text": "Ey, wer hat hier das Licht angemacht?",
      "emph": ["Licht"]
    },
    {
      "id": "o2",
      "speaker": "mr",
      "start": 33.6,
      "end": 34.6,
      "text": "Finger weg! Das ist meine Wohnung!",
      "emph": ["Wohnung"]
    },
    {
      "id": "o3",
      "speaker": "ml",
      "start": 36.8,
      "end": 37.8,
      "text": "Bruder? Bruder?!",
      "emph": ["Bruder"]
    },
    {
      "id": "o4",
      "speaker": "ml",
      "start": 38.8,
      "end": 39.8,
      "text": "Nicht ohne meinen Bruder!",
      "emph": ["Bruder"]
    },
    {
      "id": "o5",
      "speaker": "zp",
      "start": 43.0,
      "end": 43.0,
      "text": "Endlich… Luft!",
      "emph": ["Luft"],
      "maxPause": 0.5
    },
    {
      "id": "d1",
      "speaker": "arzt",
      "start": 55.3,
      "end": 56.3,
      "text": "Ständig entzündete Mandeln? Dann müssen sie raus."
    },
    {
      "id": "e1",
      "speaker": "pat",
      "start": 60.3,
      "end": 61.3,
      "text": "Darf ich jetzt endlich Eis essen?"
    },
    {
      "id": "e2",
      "speaker": "arzt",
      "start": 61.5,
      "end": 62.5,
      "text": "Kaltes ja. Aber nichts Hartes."
    },
    {
      "id": "e3",
      "speaker": "pat",
      "start": 62.5,
      "end": 63.5,
      "text": "Juhu!"
    },
    {
      "id": "e4",
      "speaker": "eis",
      "start": 63.2,
      "end": 64.2,
      "text": "Echt jetzt? Schon wieder ich?!"
    }
  ],
