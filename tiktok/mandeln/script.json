{
  "title": "Mandeln werden entfernt",
  "handle": "Dr. Arzterklärt",
  "duration": 0,
  "voiceModel": "eleven_multilingual_v2",
  "hook": [
    ["WARUM HILFT", 80, "#fff"],
    ["EIS", 150, "#7FE3FF"],
    ["NICHT MEHR?", 86, "#fff"]
  ],
  "scenes": {
    "teaser": [90, 92.8],
    "streit": [0, 14.0],
    "nachher": [20, 23.0],
    "op": [30, 44],
    "praxis": [55, 56],
