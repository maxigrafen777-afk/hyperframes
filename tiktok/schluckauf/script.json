      "id": "h1",
      "speaker": "erz",
      "start": 0.15,
      "end": 0.45,
      "text": "Dieser Mann hatte achtundsechzig Jahre lang Schluckauf.",
      "emph": ["achtundsechzig"]
    },
    {
      "id": "h2",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Tag und Nacht. Über vierhundert Millionen Mal.",
      "wait": 0.1,
      "red": ["Millionen"]
    },
    {
      "id": "h3",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Und wie es endete, glaubt kaum jemand.",
      "wait": 0.1
    },
    {
      "id": "k1",
      "speaker": "pat",
      "start": 0.4,
      "end": 0.45,
      "text": "[hiccups] Hicks!",
      "wait": 0.2
    },
    {
      "id": "o1",
      "speaker": "oma",
      "start": 0.4,
      "end": 0.45,
      "text": "[mischievous] Halt still… Buh!",
      "wait": 0.15
    },
    {
      "id": "k2",
      "speaker": "pat",
      "start": 0.4,
      "end": 0.45,
      "text": "[hiccups] …Hicks.",
      "wait": 0.3
    },
    {
      "id": "e1",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Was passiert da eigentlich?",
      "wait": 0.15
    },
    {
      "id": "e2",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Unter der Lunge liegt dein Zwerchfell. Plötzlich zuckt es.",
      "wait": 0.1,
      "emph": ["Zwerchfell"]
    },
    {
      "id": "e3",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Du saugst Luft ein. Und oben knallt die Stimmritze zu.",
      "wait": 0.1,
      "emph": ["Stimmritze"]
    },
    {
      "id": "k3",
      "speaker": "pat",
      "start": 0.4,
      "end": 0.45,
      "text": "[hiccups] Hicks!",
      "wait": 0.1
    },
    {
      "id": "e4",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Erschrecken hilft übrigens kaum. Besser: Luft anhalten oder kaltes Wasser, Schluck für Schluck.",
      "wait": 0.25,
      "emph": ["anhalten"],
      "red": ["kaum"]
    },
    {
      "id": "e5",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Aber Vorsicht.",
      "wait": 0.15,
      "red": ["Vorsicht"]
    },
    {
      "id": "e6",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Dauert er länger als zwei Tage: ab zum Arzt.",
      "wait": 0.1,
      "red": ["Tage"]
    },
    {
      "id": "e7",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Und der Mann? Achtundsechzig Jahre lang half nichts.",
      "wait": 0.2,
      "emph": ["nichts"]
    },
    {
      "id": "e8",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Bis eines Morgens: Stille.",
      "wait": 0.15,
      "emph": ["Stille"]
    },
    {
      "id": "e9",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Der Schluckauf war weg. Einfach so.",
      "wait": 0.6
    },
    {
      "id": "k4",
      "speaker": "pat",
      "start": 0.4,
      "end": 0.45,
      "text": "[relieved] Bei mir auch! Weg!",
      "wait": 0.2
    },
    {
      "id": "o2",
      "speaker": "oma",
      "start": 0.4,
      "end": 0.45,
      "text": "[mischievous] Buh!",
      "wait": 0.3
    },
    {
      "id": "k5",
      "speaker": "pat",
      "start": 0.4,
      "end": 0.45,
      "text": "[hiccups] …Hicks.",
      "wait": 0.35
