{
  "title": "Weisheitszahn wird entfernt",
  "duration": 0,
  "handle": "Dr. Arzterklärt",
  "scenes": {
    "kiefer": [0, 9.8],
    "spaeter": [9.8, 11.2],
    "nachher": [60, 66.5],
    "op": [11.2, 35.0],
    "frage": [80, 81],
    "praxis": [35.0, 42.0],
    "patient": [47.6, 50.5]
  },
  "lines": [
    {
      "id": "k1",
      "speaker": "bz",
      "start": 0.6,
      "end": 1.6,
      "text": "[shouting] Aua! Hör auf zu drücken!"
    },
    {
      "id": "k2",
      "speaker": "wz",
      "start": 2.0,
      "end": 3.0,
      "text": "Ich drück doch gar nicht. Ich will hier raus!"
    },
    {
      "id": "k3",
      "speaker": "bz",
      "start": 3.5,
      "end": 4.5,
      "text": "[angry] Hier ist kein Platz für dich!"
    },
    {
      "id": "k4",
      "speaker": "wz",
      "start": 4.6,
      "end": 5.6,
      "text": "[whining] Aber hier unten ist's so langweilig!"
    },
    {
      "id": "k5",
      "speaker": "wz",
      "start": 6.0,
      "end": 7.0,
      "text": "Ich will auch mal was KAUEN!"
    },
    {
      "id": "k6",
      "speaker": "bz",
      "start": 7.2,
      "end": 8.2,
      "text": "[shouting] Aua! Lass das!"
    },
    {
      "id": "k7",
      "speaker": "wz",
      "start": 8.4,
      "end": 9.4,
      "text": "[laughs] Upps. Das war ich nicht."
    },
    {
      "id": "l6",
      "speaker": "card",
      "start": 9.9,
      "end": 10.9,
      "text": "Später"
    },
    {
      "id": "n1",
      "speaker": "bz",
      "start": 60.3,
      "end": 61.3,
      "text": "[sighs] Du hörst nicht auf, oder?"
    },
    {
      "id": "n2",
      "speaker": "bz",
      "start": 61.5,
      "end": 62.5,
      "text": "Guck mal! Du hast mir ein LOCH gemacht!"
    },
    {
      "id": "n3",
      "speaker": "wz",
      "start": 63.0,
      "end": 64.0,
      "text": "[mischievously] Tja. Freiheit hat ihren Preis."
    },
    {
      "id": "n4",
      "speaker": "bz",
      "start": 64.5,
      "end": 65.5,
      "text": "[angry] Na gut. Dann zeig ich dir mal Freiheit."
    },
    {
      "id": "n5",
      "speaker": "bz",
      "start": 66.0,
      "end": 67.0,
      "text": "[shouting] DOC! Hol ihn raus!"
    },
    {
      "id": "l7",
      "speaker": "wz",
      "start": 12.3,
      "end": 13.3,
      "text": "[shouting] Aua! Was war DAS denn?!"
    },
    {
      "id": "l8",
      "speaker": "wz",
      "start": 14.0,
      "end": 15.0,
      "text": "[slurring] Ich spür… gar nix mehr…"
    },
    {
      "id": "l9",
      "speaker": "bz",
      "start": 17.4,
      "end": 18.4,
      "text": "[nervous] Oha. Jetzt wird's ernst."
    },
    {
      "id": "l10",
      "speaker": "wz",
      "start": 21.6,
      "end": 22.6,
      "text": "[panicked] Halt! Nicht ZERTEILEN!"
    },
    {
      "id": "l10b",
      "speaker": "wz",
      "start": 23.0,
      "end": 24.0,
      "text": "[laughs] Ha! So leicht kriegt ihr mich nicht!"
    },
    {
      "id": "l11",
      "speaker": "wz",
      "start": 25.5,
      "end": 26.5,
      "text": "[screaming] NEEEIN!"
    },
    {
      "id": "l12",
      "speaker": "bz",
      "start": 33.1,
      "end": 34.1,
      "text": "[sighs] Endlich… Ruhe."
    },
    {
      "id": "q1",
      "speaker": "pat",
      "start": 80.3,
      "end": 81.3,
      "text": "[mumbling] Doc, dad war Folter! Wad habt ihr da rausgeholt?"
    },
    {
      "id": "d1",
      "speaker": "arzt",
      "start": 35.4,
      "end": 36.4,
      "text": "Ihr Weisheitszahn lag quer und hatte keinen Platz."
    },
    {
      "id": "d2",
      "speaker": "arzt",
      "start": 38.0,
      "end": 39.0,
      "text": "Er hat gegen den Nachbarzahn gedrückt. Da ist sogar ein Loch entstanden."
    },
    {
      "id": "d3",
      "speaker": "arzt",
      "start": 41.5,
      "end": 42.5,
      "text": "Wir haben ihn geteilt, Stück für Stück entfernt, das Loch gefüllt und genäht."
    },
    {
      "id": "l16",
      "speaker": "pat",
      "start": 48.0,
      "end": 49.0,
      "text": "[mumbling] Unn wann kann isch wieda essn?"
    },
    {
      "id": "l17",
      "speaker": "arzt",
      "start": 50.3,
      "end": 51.3,
      "text": "[warmly] Heute nur was Weiches. Und gut kühlen."
    }
  ],
