{
  "title": "Weisheitszahn wird gezogen",
  "duration": 30,
  "handle": "@deinkanal",
  "lines": [
    { "id": "l1", "speaker": "bz", "start": 0.25, "end": 1.85, "text": "Hey! Hör auf zu drücken!" },
    { "id": "l2", "speaker": "wz", "start": 2.05, "end": 3.35, "text": "Ich brauch aber Platz!" },
    {
      "id": "l3",
      "speaker": "bz",
      "start": 3.55,
      "end": 5.55,
      "text": "Hier ist kein Platz! Das tut weh!"
    },
    { "id": "l4", "speaker": "wz", "start": 5.75, "end": 6.75, "text": "Pech gehabt." },
    { "id": "l5", "speaker": "bz", "start": 7.0, "end": 8.6, "text": "Ich hol den Zahnarzt!" },
    { "id": "l6", "speaker": "card", "start": 9.1, "end": 10.3, "text": "Später…" },
    { "id": "l7", "speaker": "wz", "start": 11.3, "end": 12.5, "text": "Au! Was soll das?!" },
    { "id": "l8", "speaker": "wz", "start": 14.5, "end": 15.9, "text": "Nein! Ich bleib hier!" },
    { "id": "l9", "speaker": "bz", "start": 18.5, "end": 19.7, "text": "Endlich Ruhe." },
    {
      "id": "l10",
      "speaker": "arzt",
      "start": 20.4,
      "end": 23.6,
      "text": "Hat ein Weisheitszahn keinen Platz, drückt er auf den Nachbarzahn."
    },
    {
      "id": "l11",
      "speaker": "arzt",
      "start": 23.8,
      "end": 27.2,
      "text": "Wir betäuben, öffnen das Zahnfleisch, lockern den Zahn und ziehen ihn raus."
    },
    {
      "id": "l12",
      "speaker": "arzt",
      "start": 27.4,
      "end": 29.6,
      "text": "Danach wird die Wunde genäht."
    }
  ],
