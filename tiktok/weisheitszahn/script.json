  },
  "lines": [
    {
      "id": "l1",
      "speaker": "bz",
      "start": 0.05,
      "end": 1.95,
      "text": "[shouting] AUA! Hör sofort auf zu drücken!"
    },
    {
      "id": "l2",
      "speaker": "wz",
      "start": 2.3,
      "end": 4.3,
      "text": "[laughs] Sorry. Hier ist halt kein Platz für mich."
    },
    {
      "id": "l3",
      "speaker": "bz",
      "start": 4.6,
      "end": 6.4,
      "text": "[angry] Dann wachs woanders hin! Du machst mich KAPUTT!"
    },
    {
      "id": "l4",
      "speaker": "wz",
      "start": 6.6,
      "end": 7.7,
      "text": "[mischievously] Pech gehabt. Ich bleib hier."
    },
    {
      "id": "l5",
      "speaker": "bz",
      "start": 7.9,
      "end": 9.6,
      "text": "[angry] Na warte! DAS sag ich dem Zahnarzt!"
    },
    {
      "id": "l6",
      "speaker": "card",
      "start": 9.9,
      "end": 11.1,
      "text": "Später"
    },
    {
      "id": "l7",
      "speaker": "wz",
      "start": 12.3,
      "end": 13.6,
      "text": "[shouting] AUA! Was war DAS denn?!"
    },
    {
      "id": "l8",
      "speaker": "wz",
      "start": 14.0,
      "end": 15.6,
      "text": "[slurring] Ich spür… gar nix mehr…"
    },
    {
      "id": "l9",
      "speaker": "bz",
      "start": 17.4,
      "end": 18.9,
      "text": "[nervous] Oh oh. Jetzt wird's ernst."
    },
    {
      "id": "l10",
      "speaker": "wz",
      "start": 21.6,
      "end": 23.8,
      "text": "[panicked] Halt! Ihr könnt mich doch nicht ZERTEILEN!"
    },
    {
      "id": "l11",
      "speaker": "wz",
      "start": 25.5,
      "end": 26.3,
      "text": "[screaming] NEEEIN!"
    },
    {
      "id": "l12",
      "speaker": "bz",
      "start": 33.1,
      "end": 34.8,
      "text": "[sighs] Endlich… wieder Ruhe."
    },
    {
      "id": "l13",
      "speaker": "arzt",
      "start": 35.4,
      "end": 39.0,
      "text": "Hat ein Weisheitszahn keinen Platz, drückt er gegen den Nachbarzahn."
    },
    {
      "id": "l14",
      "speaker": "arzt",
      "start": 39.2,
      "end": 43.2,
      "text": "Dann betäuben wir, öffnen das Zahnfleisch und tragen etwas Knochen ab."
    },
    {
      "id": "l15",
      "speaker": "arzt",
      "start": 43.4,
      "end": 47.3,
      "text": "Den Zahn teilen wir, holen ihn Stück für Stück raus und nähen zu."
    },
    {
      "id": "l16",
      "speaker": "pat",
      "start": 48.0,
      "end": 50.0,
      "text": "[mumbling] Unn wann kann isch wieda essn?"
    },
    {
      "id": "l17",
      "speaker": "arzt",
      "start": 50.3,
      "end": 52.3,
      "text": "[warmly] Heute nur was Weiches. Und gut kühlen."
    },
    {
      "id": "l18",
      "speaker": "pat",
      "start": 52.6,
      "end": 53.8,
      "text": "[sighs] Mmmh… okay."
    }
  ],
