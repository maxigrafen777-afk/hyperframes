{
  "title": "Weisheitszahn wird entfernt",
  "duration": 47.6,
  "handle": "Dr. Arzterklärt",
  "scenes": {
    "kiefer": [0, 9.8],
    "spaeter": [9.8, 11.2],
    "op": [11.2, 35.0],
    "praxis": [35.0, 47.6]
  },
  "lines": [
    {
      "id": "l1",
      "speaker": "bz",
      "start": 0.3,
      "end": 2.2,
      "text": "Hey, du da hinten! Hör auf zu drücken!"
    },
    {
      "id": "l2",
      "speaker": "wz",
      "start": 2.4,
      "end": 4.4,
      "text": "Geht nicht. Hier ist einfach kein Platz für mich."
    },
    {
      "id": "l3",
      "speaker": "bz",
      "start": 4.6,
      "end": 6.4,
      "text": "Dann wachs woanders hin! Das tut weh!"
    },
    {
      "id": "l4",
      "speaker": "wz",
      "start": 6.6,
      "end": 7.7,
      "text": "Pech gehabt. Ich bleibe."
    },
    {
      "id": "l5",
      "speaker": "bz",
      "start": 7.9,
      "end": 9.6,
      "text": "Na warte. Das sag ich dem Zahnarzt."
    },
    {
      "id": "l6",
      "speaker": "card",
      "start": 9.9,
      "end": 11.1,
      "text": "Später"
    },
    {
      "id": "l7",
      "speaker": "wz",
      "start": 12.3,
      "end": 13.6,
      "text": "Autsch! Was war das denn?"
    },
    {
      "id": "l8",
      "speaker": "wz",
      "start": 14.0,
      "end": 15.6,
      "text": "Ich spür… gar nichts mehr…"
    },
    {
      "id": "l9",
      "speaker": "bz",
      "start": 17.4,
      "end": 18.9,
      "text": "Oha. Jetzt wird's ernst."
    },
    {
      "id": "l10",
      "speaker": "wz",
      "start": 21.6,
      "end": 23.8,
      "text": "Moment! Ihr könnt mich doch nicht zerteilen!"
    },
    {
      "id": "l11",
      "speaker": "wz",
      "start": 25.5,
      "end": 26.3,
      "text": "Neeein!"
    },
    {
      "id": "l12",
      "speaker": "bz",
      "start": 33.1,
      "end": 34.8,
      "text": "Endlich hab ich wieder Ruhe."
    },
    {
      "id": "l13",
      "speaker": "arzt",
      "start": 35.4,
      "end": 39.0,
      "text": "Wenn ein Weisheitszahn keinen Platz hat, drückt er oft gegen den Nachbarzahn."
    },
    {
      "id": "l14",
      "speaker": "arzt",
      "start": 39.2,
      "end": 43.2,
      "text": "Dann betäuben wir, klappen das Zahnfleisch auf und tragen etwas Knochen ab."
    },
    {
      "id": "l15",
      "speaker": "arzt",
      "start": 43.4,
      "end": 47.3,
      "text": "Den Zahn teilen wir, holen ihn Stück für Stück heraus und nähen die Wunde zu."
    }
  ],
