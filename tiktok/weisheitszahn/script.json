{
  "title": "Weisheitszahn wird entfernt",
  "duration": 0,
  "handle": "Dr. Arzterklärt",
  "scenes": {
    "kiefer": [0, 9.8],
    "spaeter": [9.8, 11.2],
    "op": [11.2, 35.0],
