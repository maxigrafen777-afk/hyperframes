  "lines": [
    {
      "id": "k1",
      "speaker": "pat",
      "start": 0.3,
      "end": 0.35,
      "text": "Nur ganz kurz… gleich hab ich ihn."
    },
    {
      "id": "k2",
      "speaker": "pat",
      "start": 0.4,
      "end": 0.45,
      "text": "Autsch! Mist, jetzt blutet es.",
      "wait": 1.0
    },
    {
      "id": "t1",
      "speaker": "tuch",
      "start": 0.5,
      "end": 0.55,
      "text": "Hilfe! Ich bin schon voll!",
      "wait": 1.1
    },
    {
      "id": "t2",
      "speaker": "tuch2",
      "start": 0.6,
      "end": 0.65,
      "text": "Ich auch?! Das hört ja gar nicht auf!",
      "wait": 1.1
    },
    {
      "id": "k3",
      "speaker": "pat",
      "start": 20.3,
      "end": 20.35,
      "text": "Okay. Kopf in den Nacken."
    },
    {
      "id": "k4",
      "speaker": "pat",
      "start": 20.4,
      "end": 20.45,
      "text": "Bäh! Jetzt läuft's mir in den Hals.",
      "wait": 1.2
    },
    {
      "id": "k5",
      "speaker": "pat",
      "start": 20.5,
      "end": 20.55,
      "text": "Dann eben nach vorne und zudrücken.",
      "wait": 0.4
    },
    {
      "id": "k6",
      "speaker": "pat",
      "start": 20.6,
      "end": 20.650000000000002,
      "text": "Endlich. Es hört auf.",
      "wait": 1.9
    },
    {
      "id": "q1",
      "speaker": "pat",
      "start": 45.4,
      "end": 45.449999999999996,
      "text": "Herr Doktor, ich hab nur einmal gebohrt. Warum blutet das so?"
    },
    {
      "id": "d1",
      "speaker": "arzt",
      "start": 45.5,
      "end": 45.55,
      "text": "Vorne in der Nase liegen viele feine Äderchen direkt unter der Schleimhaut. Ein Kratzer reicht, und sie bluten."
    },
    {
      "id": "d2",
      "speaker": "arzt",
      "start": 45.6,
      "end": 45.65,
      "text": "Trockene Heizungsluft macht sie im Winter noch empfindlicher."
    },
    {
      "id": "d3",
      "speaker": "arzt",
      "start": 45.7,
      "end": 45.75,
      "text": "Also: Kopf nach vorne und die weiche Nase zehn Minuten zudrücken. Hört es nach zwanzig Minuten nicht auf, ab zum Arzt."
    },
    {
      "id": "e1",
      "speaker": "pfi",
      "start": 45.8,
      "end": 45.849999999999994,
      "text": "Nur ganz kurz…",
      "wait": 0.7
    },
    {
      "id": "e2",
      "speaker": "arzt",
      "start": 45.9,
      "end": 45.949999999999996,
      "text": "Kevin!",
      "wait": 0.2
    }
  ],
