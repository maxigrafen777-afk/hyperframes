  "lines": [
    {
      "id": "s1",
      "speaker": "zahn",
      "start": 0.1,
      "end": 0.15,
      "text": "Runter von mir! Ich war mal strahlend weiß!",
      "emph": ["weiß"]
    },
    {
      "id": "s2",
      "speaker": "stein",
      "start": 0.2,
      "end": 0.25,
      "text": "Ich wohn hier jetzt, Schätzchen.",
      "emph": ["wohn"]
    },
    {
      "id": "s3",
      "speaker": "zahn",
      "start": 0.3,
      "end": 0.35,
      "text": "Du bist hart, gelb und hässlich!",
      "emph": ["hässlich"]
    },
    {
      "id": "s4",
      "speaker": "stein",
      "start": 0.4,
      "end": 0.45,
      "text": "Danke! Kaffee und Cola kommen auch gleich.",
      "emph": ["Cola"]
    },
    {
      "id": "f1",
      "speaker": "seide",
      "start": 0.5,
      "end": 0.55,
      "text": "Keine Panik! Ich quetsch mich da durch!",
      "emph": ["Panik"],
      "wait": 0.6
    },
    {
      "id": "f2",
      "speaker": "seide",
      "start": 0.6,
      "end": 0.65,
      "text": "Ich steck fest… ich reiße!",
      "emph": ["reiße"],
      "wait": 0.7
    },
    {
      "id": "f3",
      "speaker": "stein",
      "start": 0.7,
      "end": 0.75,
      "text": "Tja. Das war's dann, Spaghetti.",
      "emph": ["Spaghetti"],
      "wait": 0.5
    },
    {
      "id": "o1",
      "speaker": "stein",
      "start": 20.9,
      "end": 20.95,
      "text": "Hey! Hör auf zu vibrieren!",
      "emph": ["vibrieren"]
    },
    {
      "id": "o2",
      "speaker": "stein",
      "start": 21.0,
      "end": 21.05,
      "text": "Nicht meine Lieblingsecke!",
      "emph": ["Lieblingsecke"],
      "wait": 1.0
    },
    {
      "id": "o3",
      "speaker": "zahn",
      "start": 21.1,
      "end": 21.15,
      "text": "Ich glänze wieder!",
      "emph": ["glänze"],
      "wait": 1.4
    },
    {
      "id": "d1",
      "speaker": "arzt",
      "start": 35.3,
      "end": 35.35,
      "text": "Zahnstein kann man nicht wegputzen. Dafür gibt es die Zahnreinigung."
    },
    {
      "id": "e1",
      "speaker": "pat",
      "start": 40.3,
      "end": 40.35,
      "text": "Endlich wieder weiße Zähne!"
    },
    {
      "id": "e2",
      "speaker": "kaffee",
      "start": 40.4,
      "end": 40.45,
      "text": "Hi! Wir sehen uns!",
      "wait": 0.6
    }
