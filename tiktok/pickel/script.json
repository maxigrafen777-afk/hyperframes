  },
  "lines": [
    {
      "id": "h1",
      "speaker": "haut",
      "start": 0.5,
      "end": 0.55,
      "text": "Hey! Das ist eine Pore, kein Hotel!"
    },
    {
      "id": "p1",
      "speaker": "pickel",
      "start": 0.6,
      "end": 0.65,
      "text": "Zu spät, Schätzchen. Wir haben schon ausgepackt."
    },
    {
      "id": "f1",
      "speaker": "finger",
      "start": 0.9,
      "end": 0.9500000000000001,
      "text": "Keine Sorge, ich drück den einfach weg!",
      "wait": 0.9
    },
    {
      "id": "h3",
      "speaker": "haut",
      "start": 1.0,
      "end": 1.05,
      "text": "Nicht! Ich hab morgen ein Date!",
      "wait": 0.2
    },
    {
      "id": "b1",
      "speaker": "bac",
      "start": 1.05,
      "end": 1.1,
      "text": "Juhu! Tiefer rein!",
      "wait": 0.75
    },
    {
      "id": "p3",
      "speaker": "pickel",
      "start": 1.1,
      "end": 1.1500000000000001,
      "text": "Danke! Jetzt bin ich noch größer.",
      "wait": 0.3
    },
    {
      "id": "g1",
      "speaker": "hand",
      "start": 1.2,
      "end": 1.25,
      "text": "Finger weg. Ich mach das steril.",
      "wait": 0.8
    },
    {
      "id": "p4",
      "speaker": "pickel",
      "start": 1.3,
      "end": 1.35,
      "text": "Hey! Was wird das?",
      "wait": 0.35
    },
    {
      "id": "p5",
      "speaker": "pickel",
      "start": 1.4,
      "end": 1.45,
      "text": "Nein! Mein schönes Zuhause!",
      "wait": 1.1
    },
    {
      "id": "g2",
      "speaker": "hand",
      "start": 1.5,
      "end": 1.55,
      "text": "Und jetzt ein Pickelpflaster drauf.",
      "wait": 0.6
    },
    {
      "id": "h4",
      "speaker": "haut",
      "start": 1.6,
      "end": 1.6500000000000001,
      "text": "Endlich glatt. Das Date ist gerettet!",
      "wait": 0.9
    },
    {
      "id": "k1",
      "speaker": "klein",
      "start": 1.7,
      "end": 1.75,
      "text": "Hi! Ich bin sein kleiner Bruder.",
      "wait": 0.7
    },
    {
      "id": "h5",
      "speaker": "haut",
      "start": 1.8,
      "end": 1.85,
      "text": "Bitte nicht vor dem Date!",
      "wait": 0.25
    },
    {
      "id": "q1",
      "speaker": "pat",
      "start": 45.4,
      "end": 45.449999999999996,
      "text": "Herr Doktor, warum darf ich Pickel nicht selbst ausdrücken?"
    },
    {
      "id": "d1",
      "speaker": "arzt",
      "start": 45.5,
      "end": 50.349999999999994,
      "text": "Mit den Fingern drückst du Bakterien tiefer in die Haut. Dann entzündet es sich stärker, und es können Narben bleiben."
    },
    {
      "id": "d2",
      "speaker": "arzt",
      "start": 45.5,
      "end": 50.449999999999996,
      "text": "Beim Hautarzt wird der Pickel desinfiziert und steril geöffnet."
    },
    {
      "id": "d3",
      "speaker": "arzt",
      "start": 45.5,
      "end": 50.55,
      "text": "Zu Hause gilt: Finger weg, Haut sauber halten und ein Pickelpflaster drauf."
    }
  ],
