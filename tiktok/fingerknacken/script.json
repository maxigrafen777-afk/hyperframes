  },
  "lines": [
    {
      "id": "h1",
      "speaker": "erz",
      "start": 0.15,
      "end": 0.45,
      "text": "Dieser Arzt hat sechzig Jahre lang nur links geknackt.",
      "emph": ["links"]
    },
    {
      "id": "h2",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Jeden Tag. Zweimal. Nie rechts.",
      "wait": 0.1,
      "red": ["Nie"]
    },
    {
      "id": "h3",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Er wollte eine Frage klären, die dir jeder schon gestellt hat.",
      "wait": 0.1,
      "emph": ["Frage"]
    },
    {
      "id": "o1",
      "speaker": "oma",
      "start": 0.4,
      "end": 0.45,
      "text": "[scolding] Hör auf zu knacken! Davon kriegst du Arthrose!",
      "wait": 0.15,
      "red": ["Arthrose"]
    },
    {
      "id": "e1",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Aber was knackt da überhaupt?",
      "wait": 0.1
    },
    {
      "id": "e2",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Du ziehst am Finger. Der Druck im Gelenk fällt.",
      "wait": 0.1,
      "emph": ["Druck"]
    },
    {
      "id": "e3",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Und plötzlich: eine Gasblase.",
      "wait": 0.1,
      "emph": ["Gasblase"]
    },
    {
      "id": "b1",
      "speaker": "blase",
      "start": 0.4,
      "end": 0.45,
      "text": "Plopp!",
      "wait": 0.3
    },
    {
      "id": "e4",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Danach geht zwanzig Minuten lang nichts mehr.",
      "wait": 0.15,
      "emph": ["zwanzig"]
    },
    {
      "id": "e5",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Aber Vorsicht.",
      "wait": 0.15,
      "red": ["Vorsicht"]
    },
    {
      "id": "e6",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Tut es weh, schwillt an oder hakt: ab zum Arzt.",
      "wait": 0.1,
      "red": ["weh"]
    },
    {
      "id": "e7",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Und der Arzt? Nach sechzig Jahren: Röntgen. Beide Hände.",
      "wait": 0.2,
      "emph": ["Röntgen"]
    },
    {
      "id": "e8",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Links: nichts. Rechts: nichts.",
      "wait": 0.15,
      "emph": ["nichts"]
    },
    {
      "id": "e9",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Keine Arthrose. Dafür: ein Preis.",
      "wait": 0.15,
      "emph": ["Preis"]
    },
    {
      "id": "k1",
      "speaker": "pat",
      "start": 0.4,
      "end": 0.45,
      "text": "[smug] Siehst du, Oma!",
      "wait": 0.1
    },
    {
      "id": "e10",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Beim Nacken allerdings… ist das eine andere Geschichte.",
      "wait": 0.4,
      "red": ["Nacken"]
    }
  ],
