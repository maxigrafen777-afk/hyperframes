{
  "title": "Fingerknacken – macht das Arthrose?",
  "handle": "Dr. Arzterklärt",
  "duration": 0,
  "voiceModel": "eleven_multilingual_v2",
  "maxPause": 0.18,
  "scenes": {
    "film": [0, 90]
