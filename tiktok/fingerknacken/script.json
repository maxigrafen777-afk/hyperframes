  "lines": [
    {
      "id": "h1",
      "speaker": "erz",
      "start": 0.3,
      "end": 0.45,
      "text": "Ein Arzt hat sechzig Jahre lang nur die Finger seiner linken Hand geknackt.",
      "emph": ["linken"]
    },
    {
      "id": "h2",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Nie die rechte. Was er am Ende rausfand, glaubt kaum jemand.",
      "wait": 0.2,
      "emph": ["rechte"]
    },
    {
      "id": "o1",
      "speaker": "oma",
      "start": 0.4,
      "end": 0.45,
      "text": "[scolding] Hör auf zu knacken! Davon kriegst du Arthrose!",
      "wait": 0.7,
      "red": ["Arthrose"]
    },
    {
      "id": "e1",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Das sagt fast jeder. Aber was knackt da eigentlich?",
      "wait": 0.25
    },
    {
      "id": "e2",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Im Gelenk ist Flüssigkeit. Ziehst du es auseinander, sinkt der Druck.",
      "wait": 0.25,
      "emph": ["Druck"]
    },
    {
      "id": "e3",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Es entsteht eine Gasblase.",
      "wait": 0.2,
      "emph": ["Gasblase"]
    },
    {
      "id": "b1",
      "speaker": "blase",
      "start": 0.4,
      "end": 0.45,
      "text": "Plopp!",
      "wait": 0.5
    },
    {
      "id": "e4",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Deshalb klappt es nicht sofort nochmal. Das Gelenk braucht etwa zwanzig Minuten.",
      "wait": 0.3,
      "emph": ["zwanzig"]
    },
    {
      "id": "e5",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Aber ein Knacken solltest du ernst nehmen.",
      "wait": 0.25,
      "red": ["ernst"]
    },
    {
      "id": "e6",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Wenn es dabei weh tut, anschwillt oder hakt: ab zum Arzt.",
      "wait": 0.25,
      "red": ["weh"]
    },
    {
      "id": "e7",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Und der Arzt mit der linken Hand? Nach sechzig Jahren verglich er beide Hände.",
      "wait": 0.3
    },
    {
      "id": "e8",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Links: keine Arthrose. Rechts: keine Arthrose.",
      "wait": 0.3,
      "emph": ["keine"]
    },
    {
      "id": "e9",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Dafür bekam er sogar einen Preis.",
      "wait": 0.25,
      "emph": ["Preis"]
    },
    {
      "id": "k1",
      "speaker": "pat",
      "start": 0.4,
      "end": 0.45,
      "text": "[smug] Siehst du, Oma!",
      "wait": 0.2
    },
    {
      "id": "e10",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Beim Nacken ist das allerdings eine andere Geschichte.",
      "wait": 0.6,
      "red": ["Nacken"]
    }
  ],
