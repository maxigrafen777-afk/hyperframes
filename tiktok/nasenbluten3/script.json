{
  "title": "Nasenbluten – Kevin bohrt (Erzählung)",
  "handle": "Dr. Arzterklärt",
  "duration": 0,
  "voiceModel": "eleven_multilingual_v2",
  "maxPause": 0.35,
  "scenes": {
    "film": [0, 90]
  },
  "order": ["film"],
  "qa": {
    "maxTakes": 4,
    "maxWer": 0.1,
