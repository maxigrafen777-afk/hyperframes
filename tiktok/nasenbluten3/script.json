  },
  "lines": [
    {
      "id": "h1",
      "speaker": "erz",
      "start": 0.3,
      "end": 0.45,
      "text": "Wenn deine Nase blutet, mach nie das, was alle machen.",
      "emph": ["nie"]
    },
    {
      "id": "e1",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Kevin bohrt. Nur ganz kurz.",
      "wait": 0.35,
      "emph": ["bohrt"]
    },
    {
      "id": "k1",
      "speaker": "pat",
      "start": 0.4,
      "end": 0.45,
      "text": "[focused] Gleich hab ich ihn…",
      "wait": 0.2
    },
    {
      "id": "e2",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Vorne in der Nase liegen hunderte feine Äderchen. Direkt unter der Haut.",
      "wait": 0.25,
      "red": ["Äderchen"]
    },
    {
      "id": "e3",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Ein Kratzer reicht.",
      "wait": 0.2,
      "red": ["Kratzer"]
    },
    {
      "id": "n1",
      "speaker": "nase",
      "start": 0.4,
      "end": 0.45,
      "text": "[shouting] Aua!",
      "wait": 0.15
    },
    {
      "id": "e4",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Es tropft. Erstes Taschentuch: durch.",
      "wait": 0.4,
      "red": ["durch"]
    },
    {
      "id": "e5",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Zweites: durch.",
      "wait": 0.7,
      "red": ["durch"]
    },
    {
      "id": "k2",
      "speaker": "pat",
      "start": 0.4,
      "end": 0.45,
      "text": "[panicked] Warum hört das nicht auf?!",
      "wait": 0.2
    },
    {
      "id": "e6",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Kevin macht, was alle machen. Kopf in den Nacken.",
      "wait": 0.3,
      "emph": ["Nacken"]
    },
    {
      "id": "e7",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Das Blut hört nicht auf. Es läuft nur woanders hin.",
      "wait": 0.5,
      "emph": ["woanders"]
    },
    {
      "id": "e8",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "In den Hals. In den Magen.",
      "wait": 0.2,
      "red": ["Magen"]
    },
    {
      "id": "k3",
      "speaker": "pat",
      "start": 0.4,
      "end": 0.45,
      "text": "[disgusted] Bäh… mir wird schlecht.",
      "wait": 0.2
    },
    {
      "id": "e9",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Richtig wäre: nach vorne beugen. Und die weiche Nase zehn Minuten zudrücken.",
      "wait": 0.3,
      "emph": ["vorne", "zehn"]
    },
    {
      "id": "e10",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Zehn Minuten später: trocken.",
      "wait": 1.0,
      "emph": ["trocken"]
    },
    {
      "id": "e11",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Kevin versteht es nicht. Er hat doch nur einmal gebohrt.",
      "wait": 0.3
    },
    {
      "id": "a1",
      "speaker": "arzt",
      "start": 0.4,
      "end": 0.45,
      "text": "Das war nicht nur der Finger. Das war die Heizung.",
      "wait": 0.25
    },
    {
      "id": "e12",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Trockene Heizungsluft macht die Äderchen brüchig. Der Finger war nur der Auslöser.",
      "wait": 0.25,
      "red": ["brüchig"]
    },
    {
      "id": "e13",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Kevin geht nach Hause. Und dreht die Heizung auf fünf.",
      "wait": 0.3,
      "emph": ["fünf"]
    },
    {
      "id": "e14",
      "speaker": "erz",
      "start": 0.4,
      "end": 0.45,
      "text": "Dann juckt seine Nase.",
      "wait": 0.6,
      "emph": ["juckt"]
    },
    {
      "id": "k4",
      "speaker": "pat",
      "start": 0.4,
      "end": 0.45,
      "text": "[sheepish] Nur ganz kurz…",
      "wait": 0.5
    }
  ],
