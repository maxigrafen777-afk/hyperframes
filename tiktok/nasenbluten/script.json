  "lines": [
    {
      "id": "f1",
      "speaker": "finger",
      "start": 0.35,
      "end": 0.39999999999999997,
      "text": "Moment, da hängt was. Das hol ich raus.",
      "settings": {
        "stability": 0.6,
        "style": 0.35
      }
    },
    {
      "id": "n1",
      "speaker": "nase",
      "start": 0.4,
      "end": 0.45,
      "text": "Nicht kratzen! Da sind meine Äderchen!",
      "wait": 0.25
    },
    {
      "id": "a1",
      "speaker": "ader",
      "start": 0.5,
      "end": 0.55,
      "text": "Au! Wir platzen!",
      "wait": 0.7
    },
    {
      "id": "f2",
      "speaker": "finger",
      "start": 0.6,
      "end": 0.65,
      "text": "Ups. Schnell, Kopf in den Nacken!",
      "wait": 0.9
    },
    {
      "id": "n2",
      "speaker": "nase",
      "start": 0.7,
      "end": 0.75,
      "text": "Falsch! Jetzt läuft alles in den Hals!",
      "wait": 1.1
    },
    {
      "id": "g1",
      "speaker": "hand",
      "start": 0.8,
      "end": 0.8500000000000001,
      "text": "Kopf nach vorne. Und vorne zudrücken.",
      "wait": 0.8
    },
    {
      "id": "a2",
      "speaker": "ader",
      "start": 0.9,
      "end": 0.9500000000000001,
      "text": "Puh. Es ist dicht!",
      "wait": 1.4
    },
    {
      "id": "g2",
      "speaker": "hand",
      "start": 1.0,
      "end": 1.05,
      "text": "Zehn Minuten festhalten.",
      "wait": 0.3
    },
    {
      "id": "q1",
      "speaker": "pat",
      "start": 45.4,
      "end": 45.449999999999996,
      "text": "Herr Doktor, warum nicht den Kopf nach hinten?"
    },
    {
      "id": "d1",
      "speaker": "arzt",
      "start": 45.5,
      "end": 45.55,
      "text": "Dann schluckst du das Blut, und dir wird übel. Kopf nach vorne und zehn Minuten die Nase zudrücken."
    },
    {
      "id": "d2",
      "speaker": "arzt",
      "start": 45.6,
      "end": 45.65,
      "text": "Hört es nach zwanzig Minuten nicht auf, ab zum Arzt."
    },
    {
      "id": "e1",
      "speaker": "finger",
      "start": 45.7,
      "end": 45.75,
      "text": "Ist da noch was drin?",
      "wait": 0.7
    },
    {
      "id": "e2",
      "speaker": "arzt",
      "start": 45.8,
      "end": 45.849999999999994,
      "text": "Kevin! Finger weg!",
      "wait": 0.2
    }
  ],
