  },
  "lines": [
    {
      "id": "t1",
      "speaker": "bd",
      "start": 90.3,
      "end": 91.3,
      "text": "[screaming] Nein! Ich will nicht weg!",
      "emph": ["Nein"],
      "reuse": "o4"
    },
    {
      "id": "s1",
      "speaker": "bd",
      "start": 0.35,
      "end": 1.35,
      "text": "Aua! Mir geht es so schlecht!",
      "emph": ["Aua"]
    },
    {
      "id": "s2",
      "speaker": "darm",
      "start": 1.8,
      "end": 2.8,
      "text": "Du bist nur ein Wurmfortsatz. Stell dich nicht so an."
    },
    {
      "id": "s3",
      "speaker": "bd",
      "start": 3.4,
      "end": 4.4,
      "text": "Nur?! Da steckt was in mir fest!",
      "emph": ["fest"]
    },
    {
      "id": "s4",
      "speaker": "darm",
      "start": 4.8,
      "end": 5.8,
      "text": "Ein Kot-Stein. Selber schuld.",
      "emph": ["Kot-Stein"]
    },
    {
      "id": "l6",
      "speaker": "card",
      "start": 10.1,
      "end": 11.1,
      "text": "Später"
    },
    {
      "id": "n1",
      "speaker": "bd",
      "start": 20.3,
      "end": 21.3,
      "text": "Hilfe! Ich platze gleich!",
      "emph": ["platze"]
    },
    {
      "id": "n2",
      "speaker": "darm",
      "start": 21.4,
      "end": 22.4,
      "text": "Bloß nicht! Dann entzündet sich hier alles!",
      "emph": ["alles"]
    },
    {
      "id": "n3",
      "speaker": "darm",
      "start": 22.8,
      "end": 23.8,
      "text": "Herr Doktor! Schnell!",
      "emph": ["Doktor"]
    },
    {
      "id": "a1",
      "speaker": "arzt",
      "start": 30.2,
      "end": 31.2,
      "text": "Der Patient schläft. Zuerst setzen wir drei kleine Zugänge.",
      "emph": ["drei"]
    },
    {
      "id": "a2",
      "speaker": "arzt",
      "start": 31.0,
      "end": 32.0,
      "text": "Gas hebt die Bauchdecke an. So haben wir Platz.",
      "emph": ["Gas"]
    },
    {
      "id": "o1",
      "speaker": "darm",
      "start": 31.5,
      "end": 32.5,
      "text": "Hey! Wer pumpt hier Luft rein?!"
    },
    {
      "id": "a3",
      "speaker": "arzt",
      "start": 32.0,
      "end": 33.0,
      "text": "Durch die Mitte kommt die Kamera.",
      "emph": ["Kamera"]
    },
    {
      "id": "a4",
      "speaker": "arzt",
      "start": 33.0,
      "end": 34.0,
      "text": "Eine Zange hält den Blinddarm fest.",
      "emph": ["Zange"]
    },
    {
      "id": "o3",
      "speaker": "bd",
      "start": 33.5,
      "end": 34.5,
      "text": "Finger weg von mir!"
    },
    {
      "id": "a5",
      "speaker": "arzt",
      "start": 34.0,
      "end": 35.0,
      "text": "Zwei Clips an die Basis. Dann schneiden wir dazwischen.",
      "emph": ["Clips"]
    },
    {
      "id": "o4",
      "speaker": "bd",
      "start": 34.5,
      "end": 35.5,
      "text": "Nein! Ich will nicht weg!",
      "emph": ["Nein"]
    },
    {
      "id": "a6",
      "speaker": "arzt",
      "start": 35.0,
      "end": 36.0,
      "text": "Er kommt in einen Beutel und raus durch den Zugang.",
      "emph": ["Beutel"]
    },
    {
      "id": "o5",
      "speaker": "bd",
      "start": 35.5,
      "end": 36.5,
      "text": "Ich komme wieder!"
    },
    {
      "id": "o6",
      "speaker": "darm",
      "start": 36.0,
      "end": 37.0,
      "text": "Nein. Kommst du nicht."
    },
    {
      "id": "d1",
      "speaker": "arzt",
      "start": 65.3,
      "end": 66.3,
      "text": "Man kann gut ohne ihn leben. Er wäre fast durchgebrochen."
    },
    {
      "id": "e1",
      "speaker": "pat",
      "start": 70.3,
      "end": 71.3,
      "text": "Und warum tut Lachen so weh?"
    },
    {
      "id": "e2",
      "speaker": "arzt",
      "start": 71.5,
      "end": 72.5,
      "text": "Das ist die ersten Tage normal. Also lieber keine Witze."
    },
    {
      "id": "e3",
      "speaker": "pat",
      "start": 73.2,
      "end": 74.2,
      "text": "Haha… au! Au, au!"
    }
  ],
