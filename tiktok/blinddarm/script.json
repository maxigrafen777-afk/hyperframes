{
  "title": "Blinddarm wird entfernt",
  "handle": "Dr. Arzterklärt",
  "duration": 0,
  "voiceModel": "eleven_multilingual_v2",
  "hook": [
    ["WIE PASST DER", 80, "#fff"],
    ["BLINDDARM", 128, "#FFE14D"],
