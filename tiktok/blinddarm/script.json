{
  "title": "Blinddarm wird entfernt",
  "handle": "Dr. Arzterklärt",
  "duration": 0,
  "voiceModel": "eleven_v3",
  "hook": [
    ["SO WIRD DEIN", 80, "#fff"],
    ["BLINDDARM", 128, "#FFE14D"],
    ["ENTFERNT", 80, "#fff"]
  ],
  "scenes": {
    "streit": [0, 9.5],
    "spaeter": [10, 11.4],
    "nachher": [20, 24.5],
    "op": [30, 43.5],
    "frage": [50, 52],
    "praxis": [55, 58],
    "patient": [65, 69.5]
  },
  "order": ["streit", "spaeter", "nachher", "op", "frage", "praxis", "patient"],
  "qa": {
    "maxTakes": 3,
    "maxWer": 0.1
  },
  "lines": [
    {
      "id": "s1",
      "speaker": "bd",
      "start": 0.35,
      "end": 1.35,
      "text": "[shouting] Aua! Mir geht es so schlecht!",
      "emph": ["Aua"]
    },
    {
      "id": "s2",
      "speaker": "darm",
      "start": 1.8,
      "end": 2.8,
      "text": "[annoyed] Du bist nur ein Wurmfortsatz. Stell dich nicht so an."
    },
    {
      "id": "s3",
      "speaker": "bd",
      "start": 3.4,
      "end": 4.4,
      "text": "[offended] Nur?! Da steckt was in mir fest!",
      "emph": ["fest"]
    },
    {
      "id": "s4",
      "speaker": "darm",
      "start": 4.8,
      "end": 5.8,
      "text": "[sighs] Ein Kot-Stein. Selber schuld.",
      "emph": ["Kot-Stein"]
    },
    {
      "id": "s5",
      "speaker": "bd",
      "start": 6.2,
      "end": 7.2,
      "text": "[panicked] Ich schwelle an! Ich werd ganz rot!",
      "emph": ["rot"]
    },
    {
      "id": "l6",
      "speaker": "card",
      "start": 10.1,
      "end": 11.1,
      "text": "Später"
    },
    {
      "id": "n1",
      "speaker": "bd",
      "start": 20.3,
      "end": 21.3,
      "text": "[screaming] Ich platz gleich!",
      "emph": ["platz"]
    },
    {
      "id": "n2",
      "speaker": "darm",
      "start": 21.4,
      "end": 22.4,
      "text": "[panicked] Bloß nicht! Dann entzündet sich hier alles!",
      "emph": ["alles"]
    },
    {
      "id": "n3",
      "speaker": "darm",
      "start": 23.0,
      "end": 24.0,
      "text": "[shouting] Herr Doktor! Schnell!",
      "emph": ["Doktor"]
    },
    {
      "id": "o1",
      "speaker": "darm",
      "start": 30.6,
      "end": 31.6,
      "text": "[confused] Hey! Wer pumpt hier Luft rein?!",
      "emph": ["Luft"]
    },
    {
      "id": "o2",
      "speaker": "bd",
      "start": 33.0,
      "end": 34.0,
      "text": "[shouting] Ah! Das Licht!",
      "emph": ["Licht"]
    },
    {
      "id": "o3",
      "speaker": "bd",
      "start": 34.6,
      "end": 35.6,
      "text": "[panicked] Finger weg von mir!"
    },
    {
      "id": "o4",
      "speaker": "bd",
      "start": 36.4,
      "end": 37.4,
      "text": "[nervous] Was sind das für Klammern?!",
      "emph": ["Klammern"]
    },
    {
      "id": "o5",
      "speaker": "bd",
      "start": 38.0,
      "end": 39.0,
      "text": "[screaming] Nein! Ich will nicht weg!",
      "emph": ["Nein"]
    },
    {
      "id": "o6",
      "speaker": "bd",
      "start": 39.7,
      "end": 40.7,
      "text": "[dramatic] Ich komme wieder!"
    },
    {
      "id": "o7",
      "speaker": "darm",
      "start": 41.2,
      "end": 42.2,
      "text": "[smug] Nein. Kommst du nicht."
    },
    {
      "id": "q1",
      "speaker": "pat",
      "start": 50.3,
      "end": 51.3,
      "text": "Herr Doktor, brauch ich den Blinddarm denn nicht?"
    },
    {
      "id": "d1",
      "speaker": "arzt",
      "start": 55.4,
      "end": 56.4,
      "text": "Man kann gut ohne ihn leben. Er war entzündet und wäre fast durchgebrochen."
    },
    {
      "id": "d2",
      "speaker": "arzt",
      "start": 57.0,
      "end": 58.0,
      "text": "Wir haben ihn durch drei kleine Schnitte mit einer Kamera entfernt.",
      "emph": ["drei"]
    },
    {
      "id": "e1",
      "speaker": "pat",
      "start": 65.3,
      "end": 66.3,
      "text": "Und warum tut Lachen so weh?"
    },
    {
      "id": "e2",
      "speaker": "arzt",
      "start": 66.5,
      "end": 67.5,
      "text": "[warmly] Das ist die ersten Tage normal. Also lieber keine Witze."
    },
    {
      "id": "e3",
      "speaker": "pat",
      "start": 68.2,
      "end": 69.2,
      "text": "[laughs] Au! Au, au!"
    }
  ],
