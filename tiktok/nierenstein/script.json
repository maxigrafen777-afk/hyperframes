  "lines": [
    {
      "id": "n1",
      "speaker": "niere",
      "start": 0.15,
      "end": 0.2,
      "text": "Aua! Wer verstopft da meinen Abfluss?",
      "emph": ["Abfluss"]
    },
    {
      "id": "s1",
      "speaker": "stein",
      "start": 0.2,
      "end": 0.25,
      "text": "Ich. Dein neuer Untermieter.",
      "emph": ["Untermieter"]
    },
    {
      "id": "n2",
      "speaker": "niere",
      "start": 0.3,
      "end": 0.35,
      "text": "Du bist spitz, hart und steckst fest!",
      "emph": ["spitz"]
    },
    {
      "id": "s2",
      "speaker": "stein",
      "start": 0.4,
      "end": 0.45,
      "text": "Tja. Hättest du mal mehr getrunken.",
      "emph": ["getrunken"]
    },
    {
      "id": "b1",
      "speaker": "bier",
      "start": 0.5,
      "end": 0.55,
      "text": "Ganz ruhig, Kumpel. Ich spül den Kerl raus.",
      "emph": ["Kumpel"],
      "wait": 0.7
    },
    {
      "id": "b2",
      "speaker": "bier",
      "start": 0.7,
      "end": 0.75,
      "text": "Hicks… der bewegt sich keinen Millimeter.",
      "emph": ["Millimeter"],
      "wait": 1.5
    },
    {
      "id": "n3",
      "speaker": "niere",
      "start": 0.8,
      "end": 0.8500000000000001,
      "text": "Ich platz gleich! Holt einen Arzt!",
      "emph": ["Arzt"]
    },
    {
      "id": "o1",
      "speaker": "stein",
      "start": 26.05,
      "end": 26.35,
      "text": "Hey! Warum zielt ihr auf mich?",
      "emph": ["zielt"]
    },
    {
      "id": "o2",
      "speaker": "stein",
      "start": 26.4,
      "end": 26.45,
      "text": "Au! Au! Ich zerbrösel!",
      "emph": ["zerbrösel"],
      "wait": 1.25
    },
    {
      "id": "o3",
      "speaker": "niere",
      "start": 26.5,
      "end": 26.55,
      "text": "Endlich wieder frei!",
      "emph": ["frei"],
      "wait": 1.4
    },
    {
      "id": "o4",
      "speaker": "bier",
      "start": 26.6,
      "end": 26.650000000000002,
      "text": "Siehste? Ich hab ihn rausgespült!",
      "emph": ["Siehste"]
    },
    {
      "id": "o5",
      "speaker": "niere",
      "start": 26.7,
      "end": 26.75,
      "text": "Das war Wasser, du Pfeife!",
      "emph": ["Wasser"]
    },
    {
      "id": "d1",
      "speaker": "arzt",
      "start": 45.3,
      "end": 45.349999999999994,
      "text": "Große Nierensteine zertrümmern wir mit Stoßwellen. Und viel Wasser trinken beugt vor."
    },
    {
      "id": "e1",
      "speaker": "pat",
      "start": 50.4,
      "end": 50.449999999999996,
      "text": "Ab heute trink ich viel mehr!",
      "emph": ["mehr"]
    },
    {
      "id": "e2",
      "speaker": "bier",
      "start": 50.5,
      "end": 50.55,
      "text": "Endlich!",
      "wait": 0.3
    },
    {
      "id": "e3",
      "speaker": "pat",
      "start": 50.6,
      "end": 50.65,
      "text": "Wasser.",
      "wait": 0.4
    },
    {
      "id": "e4",
      "speaker": "bier",
      "start": 50.7,
      "end": 50.75,
      "text": "Mist.",
      "wait": 0.4
    }
  ],
